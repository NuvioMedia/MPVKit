+
+static void reset_avctx(struct mp_filter *vd);
+
+#define NUVIO_GOP_MAX_BYTES (96 * 1024 * 1024)
+#define NUVIO_GOP_MAX_PACKETS 1200
+#define NUVIO_GOP_MAX_REPLAYS 3
+
+static void gop_clear(vd_ffmpeg_ctx *ctx)
+{
+    for (int n = 0; n < ctx->num_gop_packets; n++)
+        talloc_free(ctx->gop_packets[n]);
+    ctx->num_gop_packets = 0;
+    ctx->gop_bytes = 0;
+}
+
+static void gop_record(struct mp_filter *vd, struct demux_packet *pkt)
+{
+    vd_ffmpeg_ctx *ctx = vd->priv;
+
+    if (pkt->keyframe) {
+        gop_clear(ctx);
+        ctx->gop_valid = true;
+        ctx->gop_replays = 0;
+    }
+    if (!ctx->gop_valid)
+        return;
+    struct demux_packet *copy = NULL;
+    if (ctx->num_gop_packets < NUVIO_GOP_MAX_PACKETS &&
+        ctx->gop_bytes + pkt->len <= NUVIO_GOP_MAX_BYTES)
+        copy = demux_copy_packet(vd->packet_pool, pkt);
+    if (!copy) {
+        // Too long to keep: behave as before until the next keyframe.
+        gop_clear(ctx);
+        ctx->gop_valid = false;
+        return;
+    }
+    MP_TARRAY_APPEND(ctx, ctx->gop_packets, ctx->num_gop_packets, copy);
+    ctx->gop_bytes += pkt->len;
+}
+
+static void gop_replay(struct mp_filter *vd)
+{
+    vd_ffmpeg_ctx *ctx = vd->priv;
+
+    ctx->gop_recover = false;
+    ctx->gop_replays += 1;
+    ctx->hwdec_fail_count = 0;
+    MP_VERBOSE(vd, "Hardware decoder lost, replaying %d packets from the "
+               "last keyframe.\n", ctx->num_gop_packets);
+    reset_avctx(vd);
+    for (int n = 0; n < ctx->num_gop_packets; n++) {
+        struct demux_packet *copy = demux_copy_packet(vd->packet_pool,
+                                                      ctx->gop_packets[n]);
+        if (copy)
+            MP_TARRAY_APPEND(ctx, ctx->requeue_packets,
+                             ctx->num_requeue_packets, copy);
+    }
+    // Frames up to the last one shown are decoded only as references.
+    ctx->gop_drop_pts = ctx->last_out_pts;
 }
 
