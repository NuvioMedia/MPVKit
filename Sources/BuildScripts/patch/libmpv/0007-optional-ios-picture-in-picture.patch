diff --git a/video/out/nuvio_pip.m b/video/out/nuvio_pip.m
new file mode 100644
index 0000000..97ce5ac
--- /dev/null
+++ b/video/out/nuvio_pip.m
@@ -0,0 +1,37 @@
+// Local PiP prototype. The host retains the Metal layer for the lifetime of the VO.
+#import <Foundation/Foundation.h>
+#import <CoreVideo/CoreVideo.h>
+#import <TargetConditionals.h>
+#include "video/mp_image.h"
+#include "video/img_format.h"
+
+@protocol NuvioPiPFrameSink <NSObject>
+@property (readonly) BOOL nuvioPiPConsumesVideo;
+- (void)nuvioEnqueuePiPFrame:(CVPixelBufferRef)buffer presentationTime:(double)pts isPictureInPictureFrame:(BOOL)active;
+@end
+
+bool nuvio_pip_active(int64_t layer)
+{
+    if (layer <= 0 || !TARGET_OS_IOS || TARGET_OS_MACCATALYST)
+        return false;
+    id object = (__bridge id)(void *)(intptr_t)layer;
+    return [object respondsToSelector:@selector(nuvioPiPConsumesVideo)] &&
+        [(id<NuvioPiPFrameSink>)object nuvioPiPConsumesVideo];
+}
+
+bool nuvio_pip_offer_frame(int64_t layer, struct mp_image *image)
+{
+    const bool active = nuvio_pip_active(layer);
+    if (layer <= 0 || !TARGET_OS_IOS || TARGET_OS_MACCATALYST)
+        return false;
+    if (!image || image->imgfmt != IMGFMT_VIDEOTOOLBOX || !image->planes[3])
+        return active;
+    id object = (__bridge id)(void *)(intptr_t)layer;
+    if ([object respondsToSelector:@selector(nuvioEnqueuePiPFrame:presentationTime:isPictureInPictureFrame:)]) {
+        @autoreleasepool {
+            [(id<NuvioPiPFrameSink>)object nuvioEnqueuePiPFrame:
+                (CVPixelBufferRef)image->planes[3] presentationTime:image->pts isPictureInPictureFrame:active];
+        }
+    }
+    return active;
+}
